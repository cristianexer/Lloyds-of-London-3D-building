{
  "name": "inside-lloyds",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run model:manifest && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "model:manifest": "node --import tsx scripts/export-manifest.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "format": "prettier --write src tests scripts docs README.md *.json *.ts index.html"
  },
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.3.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
